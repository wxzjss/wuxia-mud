{
  "id": "demo_func",
  "_wxTrace": "wxt-official-demo_func",
  "name": "轻松江湖（功能示例）",
  "version": "1.0.0",
  "author": "武侠行官方",
  "category": "功能",
  "desc": "不改内容，只改规则：双倍经验、双倍金钱、脱战自动回血、击杀额外赏钱、一键捡光（宏指令）。功能类 Mod 的写法示例，适合新手研究。",
  "tags": [
    "功能",
    "便利",
    "示例"
  ],
  "gameVersion": "1.0.0",
  "rules": [
    {
      "name": "双倍经验",
      "kind": "multiply",
      "target": "exp",
      "value": 2,
      "cond": "",
      "effect": ""
    },
    {
      "name": "双倍金钱",
      "kind": "multiply",
      "target": "money",
      "value": 2,
      "cond": "",
      "effect": ""
    },
    {
      "name": "脱战回血",
      "kind": "onEvent",
      "target": "onTick",
      "value": 1,
      "cond": [
        "!combat",
        "!tuning"
      ],
      "effect": "+hp:8"
    },
    {
      "name": "击杀额外赏钱",
      "kind": "onEvent",
      "target": "onKill",
      "value": 1,
      "cond": "",
      "effect": "+money:20"
    },
    {
      "name": "新手保护（初窥门径以下减伤）",
      "kind": "additive",
      "target": "damageTaken",
      "value": -5,
      "cond": "realm<=1",
      "effect": ""
    },
    {
      "name": "一键捡光（宏指令）",
      "kind": "macro",
      "target": "拾取",
      "value": 1,
      "cond": "room.items>0",
      "effect": "get all"
    }
  ],
  "meta": {
    "playstyle": "轻松",
    "note": "本 Mod 只调整数值规则，不新增任何内容。"
  },
  "enabledByDefault": false
}
