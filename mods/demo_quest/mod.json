{
  "id": "demo_quest",
  "name": "江南除害（剧情示例）",
  "version": "1.0.0",
  "author": "武侠行官方",
  "category": "剧情",
  "desc": "一个完整的三阶段剧情：在官道游侠处接任务 → 北上密林杀山贼头目 → 回来复命领赏。演示了任务阶段（flag / kill）、对话树、NPC 与奖励的完整串联。",
  "tags": ["剧情", "任务", "示例", "江南"],
  "gameVersion": "1.0.0",
  "quests": [
    {
      "id": "q_demo_bandit",
      "name": "江南除害",
      "giver": "demo_swordman",
      "level": 1,
      "type": "支线",
      "desc": "江南官道上有个游侠，说附近山贼猖狂，愿出钱请人除去贼首。贼首盘踞在官道往北的密林深处。",
      "rewards": {
        "exp": 400,
        "pot": 80,
        "money": 300,
        "items": ["jinchuang_yao", "wugou_jian"]
      },
      "stages": [
        {
          "desc": "答应游侠的请求",
          "kind": "flag",
          "key": "q_demo_start",
          "count": 1,
          "onDone": "say:游侠抱拳：「多谢！贼首就在官道往北的密林里，你顺着路标走，看到一片黑松林就是了。」"
        },
        {
          "desc": "击杀山贼头目",
          "kind": "kill",
          "key": "mob_bandit_chief",
          "count": 1,
          "onDone": "say:（你抹去剑上血迹）贼首已除，该回去复命了。"
        },
        {
          "desc": "回去向游侠复命",
          "kind": "flag",
          "key": "q_demo_report",
          "count": 1,
          "onDone": "narrate:游侠听罢，长出一口气：「江南百姓，欠你一个人情。」"
        }
      ],
      "abandonable": true
    }
  ],
  "dialogues": [
    {
      "id": "dlg_demo_youxia",
      "name": "游侠的托付",
      "npc": "demo_swordman",
      "start": "n1",
      "cond": "level>=1",
      "nodes": [
        {
          "id": "n1",
          "who": "",
          "text": "这位侠士，且慢行。近日官道旁山贼出没，商旅遭殃。我看阁下步履沉稳，是练过的人——可愿出手相助？",
          "options": [
            { "label": "愿往，这便去除了那贼首", "next": "n2", "effect": "quest:q_demo_bandit:2" },
            { "label": "与我无关", "next": "n3" },
            { "label": "山贼有多少人？", "next": "n4" }
          ]
        },
        {
          "id": "n2",
          "who": "",
          "text": "多谢！贼首就在官道往北的密林深处，身边跟着十几号人，你要当心。",
          "options": [
            { "label": "（转身离去）", "next": "" }
          ]
        },
        {
          "id": "n3",
          "who": "",
          "text": "（游侠愣了一下，随即苦笑）唉……罢了，人各有志。终归是我强人所难。",
          "options": [
            { "label": "（离去）", "next": "" },
            { "label": "等等——我去", "next": "n2", "effect": "quest:q_demo_bandit:2" }
          ]
        },
        {
          "id": "n4",
          "who": "",
          "text": "少说也有十五六个，贼首绰号「黑风」，使一对铁鞭，手上有不少人命。你若去，最好先练练功夫。",
          "options": [
            { "label": "我明白了，这就去", "next": "n2", "effect": "quest:q_demo_bandit:2" },
            { "label": "容我再想想", "next": "" }
          ]
        }
      ]
    }
  ],
  "npcs": [
    {
      "id": "demo_swordman",
      "name": "游侠",
      "title": "江湖浪客",
      "gender": "male",
      "room": "road_jiangnan_1",
      "level": 15,
      "hp": 500,
      "mp": 200,
      "atk": 38,
      "def": 20,
      "dodge": 25,
      "speed": 28,
      "desc": "一个背着长剑的年轻游侠，眉宇间有几分正气，衣衫却已洗得发白。他站在道旁，像是在等什么人。",
      "talk": [
        "（他抱拳）江湖路远，侠士珍重。",
        "（他望了望北边）听说那片林子里不太平，你若要过，多加小心。"
      ],
      "canTeach": true,
      "teach": ["basic_sword", "basic_parry"],
      "quests": ["q_demo_bandit"],
      "ask": {
        "任务": "（他指了指北边）黑风那伙贼，盘踞在密林深处。你若愿意，替我去会会他。",
        "武学": "我这点剑法，不值一提。倒是可以教你几式基础的。",
        "江湖": "我走南闯北这些年，见过太多不平事。能管一件是一件。"
      },
      "askDefault": "（游侠摇头）这个……我不太清楚。",
      "loot": ["iron_sword_basic"],
      "actions": [
        {
          "cmd": "复命",
          "cond": "flag:q_demo_start",
          "effects": [
            "say:（游侠听罢，长出一口气）江南百姓，欠你一个人情。",
            "flag:q_demo_report"
          ]
        }
      ]
    }
  ]
}
