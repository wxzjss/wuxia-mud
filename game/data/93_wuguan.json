    "wg_jiangnan": {
      "id": "wg_jiangnan",
      "name": "江南城·武馆",
      "region": "jiangnan",
      "desc": "三间打通的大屋，地上砸出两个浅坑，是几十年踩出来的。架上刀枪剑棍各一，都用得发亮。墙边一条长凳，坐过不知多少人。周教头坐在门口，看着院里的人打拳。",
      "exits": {
        "se": "jiangnan_market"
      },
      "npcs": [
        "wg_zhou"
      ]
    },
    "wg_gusu": {
      "id": "wg_gusu",
      "name": "姑苏·武馆",
      "region": "gusu",
      "desc": "院子不大，一株老槐把天遮去一半。石锁、木桩、沙袋沿墙排开，沙袋上的补丁一层压一层。陆教头背着手站在廊下，看谁的马步先塌。",
      "exits": {
        "s": "gusu_zhai_lane"
      },
      "npcs": [
        "wg_lu"
      ]
    },
    "wg_luoyang": {
      "id": "wg_luoyang",
      "name": "洛阳城·武馆",
      "region": "luoyang",
      "desc": "临街一溜五间，门板卸了下来靠墙立着。院里人不少，多是穿着短打的汉子，也有两三个读书人模样的在后头比划。裴教头手里一根藤条，谁手腕塌了，他拿藤条点一下。",
      "exits": {
        "se": "luoyang_market"
      },
      "npcs": [
        "wg_pei"
      ]
    },
    "wg_changan": {
      "id": "wg_changan",
      "name": "长安城·武馆",
      "region": "changan",
      "desc": "京城里的武馆规矩大。进门先净手，兵器架擦得看不见灰。墙上挂着一块旧匾，字是前朝人写的，落款已经认不出了。马教头轻易不开口。",
      "exits": {
        "se": "changan_market"
      },
      "npcs": [
        "wg_ma"
      ]
    },
    "wg_chengdu": {
      "id": "wg_chengdu",
      "name": "成都府·武馆",
      "region": "chengdu",
      "desc": "竹篱围出的一片空地，地上铺的是碎石子。练功的人赤着脚，踩得脚底板发亮。唐教头蹲在台阶上，一边剥豆子一边看。",
      "exits": {
        "se": "chengdu_market"
      },
      "npcs": [
        "wg_tang"
      ]
    },
    "wg_xiangyang": {
      "id": "wg_xiangyang",
      "name": "襄阳城·武馆",
      "region": "xiangyang",
      "desc": "襄阳是兵家必争的地界，这座武馆里练的就不是花架子了。一排木枪靠在墙上，枪头都卸了。韩教头让人两两对打，自己踱着看，谁的脚下虚就停谁的。",
      "exits": {
        "se": "xiangyang_market"
      },
      "npcs": [
        "wg_han"
      ]
    }
  },
