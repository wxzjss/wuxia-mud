            }
          },
          "effects": [
            {
              "type": "narrate",
              "raw": "蓝若愚翻了十二年的乱葬岗，为的是找一个人。那个人贩子的名字，他从旁人嘴里听过。"
            },
            {
              "type": "quest",
              "args": [
                "hk_npcv_223_meimei",
                0
