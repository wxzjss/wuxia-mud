            {
              "type": "narrate",
              "raw": "你替他跑了一趟城外出诊。回来的路上他忽然开口：「昨晚那口箱子，你多看了一眼。看第二眼，就看出来了。」"
            },
            {
              "type": "narrate",
              "raw": "他把药箱掀开给你看。箱底烙着字号，烙铁缺了一角。管市的官秤砣底上，缺的是同一角。"
            },
            {
              "type": "flag",
              "args": [
                "act2_cd_ledger"
              ]
            }
          ]
        }
      ]
    },
    "npcv_223": {
