          "next": 99,
          "effects": [
            {
              "type": "narrate",
              "raw": "仓角的米堆比别处浅一截，底下垫着细沙。仓册摊在案上，三个月的进项一栏比一栏薄，出仓那一栏的字迹倒是一次比一次工整。"
            },
            {
              "type": "say",
              "raw": "「掺过一遍的米，今晚就得多一碗饭，少一碗饭。」"
            },
            {
              "type": "menu",
              "raw": "这笔账|替他把账做平>+karma:-20;+money:400;+exp:200;+pot:70;flag:hk_npcv_174_tuntang_mix;;报到官上>+rep:朝廷:25;+exp:240;favor:npcv_174:-50;incvar:favor_npcv_174:-50;flag:hk_npcv_174_tuntang_report"
            },
            {
              "type": "narrate",
              "raw": "临出仓你回头又看了一眼仓册。进项一栏的骑缝章缺了半个，缺的那半个印，弧口朝左。这种印你见过。"
            },
            {
              "type": "+rep",
              "args": [
                "洛阳",
                60
              ]
            },
            {
              "type": "flag",
              "args": [
                "clue_luoyang"
              ]
            },
            {
              "type": "incvar",
              "args": [
                "clue_count",
                1
              ]
            }
          ]
        }
      ],
      "rewards": [
        {
          "type": "say",
          "raw": "蒋倦把那袋米挪到仓角，填回一层整米进了门面。他说：「这几桩案子搁在一起看，少的东西是同一路人拿走的。」"
        }
      ]
    },
