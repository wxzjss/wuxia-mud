  "quests": {
    "hk_npcv_174_tuntang": {
      "id": "hk_npcv_174_tuntang",
      "name": "仓里那三个月",
      "type": "支线",
      "npc": "npcv_174",
      "giver": "npcv_174",
      "level": 7,
      "desc": "洛阳官仓亏空三个月。管仓的老吏蒋倦拿自己的米填，填不满，也不想再填了。他要看一眼：你替他把账对出来。",
      "stages": [
        {
          "desc": "去洛阳·官仓，看那三个月的账对不对得上",
          "targets": [
            {
              "id": "go0",
              "kind": "room",
              "key": "ly_granary",
              "count": 1,
              "var": "hk_npcv_174_tuntang_go0",
              "desc": "去洛阳·官仓，看那三个月的账对不对得上"
            }
          ],
          "next": 99,
          "effects": [
            {
              "type": "narrate",
              "raw": "仓角的米堆比别处浅一截，底下垫着细沙。仓册摊在案上，三个月的进项一栏比一栏薄，出仓那一栏的字迹倒是一次比一次工整。"
            },
            {
              "type": "say",
              "raw": "「掺过一遍的米，今晚就得多一碗饭，少一碗饭。」"
            },
            {
              "type": "menu",
              "raw": "这笔账|替他把账做平>+karma:-20;+money:400;+exp:200;+pot:70;flag:hk_npcv_174_tuntang_mix;;报到官上>+rep:朝廷:25;+exp:240;favor:npcv_174:-50;incvar:favor_npcv_174:-50;flag:hk_npcv_174_tuntang_report"
            },
            {
              "type": "narrate",
              "raw": "临出仓你回头又看了一眼仓册。进项一栏的骑缝章缺了半个，缺的那半个印，弧口朝左。这种印你见过。"
            },
            {
              "type": "+rep",
              "args": [
                "洛阳",
                60
              ]
            },
            {
              "type": "flag",
              "args": [
                "clue_luoyang"
              ]
            },
            {
              "type": "incvar",
              "args": [
                "clue_count",
                1
              ]
            }
          ]
        }
      ],
      "rewards": [
        {
          "type": "say",
          "raw": "蒋倦把那袋米挪到仓角，填回一层整米进了门面。他说：「这几桩案子搁在一起看，少的东西是同一路人拿走的。」"
        }
      ]
    },
    "hk_npcv_174_zhangxin": {
      "id": "hk_npcv_174_zhangxin",
      "name": "掌心里那把米",
      "type": "支线",
      "npc": "npcv_174",
      "giver": "npcv_174",
