            }
          ]
        },
        {
          "cmd": "问瞎婆",
          "label": "问瞎婆",
          "keywords": [],
          "desc": "城外那个瞎婆",
          "cond": {
            "not": {
              "quest": "hk_npcv_223_laoxiapo"
            }
          },
          "effects": [
            {
              "type": "narrate",
              "raw": "蓝若愚偷来的钱，一分没花，全给了城外一个瞎婆。"
            },
            {
              "type": "quest",
              "args": [
                "hk_npcv_223_laoxiapo",
                0
              ]
            }
          ]
        },
        {
          "cmd": "调门里卷宗",
          "label": "调门里卷宗",
          "keywords": [
            "卷宗",
            "调卷"
          ],
          "desc": "门里的卷宗还能调出旧账（门派咬合）",
          "cond": {
            "hasSect": true,
            "notFlag": "act2_gs_ledger"
          },
          "once": true,
          "effects": [
            {
              "type": "narrate",
              "raw": "你回门里调了卷宗。十二年前的漕运案卷缺了一页，缺页的编号还在目录上。你把编号抄给了他。"
            },
            {
              "type": "narrate",
              "raw": "他照编号找到一条旧船。船帮内侧刻着弯钩，钩尾挑得老高。走这记号的船，装的不止漕米。"
            },
            {
              "type": "flag",
              "args": [
                "act2_gs_ledger"
              ]
            },
            {
              "type": "contrib",
              "args": [
                "本门",
                40
              ]
            },
            {
              "type": "sys",
              "raw": "你在门里的差事簿上记了一笔。"
            }
          ]
        },
        {
          "cmd": "陪他守夜",
          "label": "陪他守夜",
          "keywords": [
            "守夜",
            "守着"
          ],
          "desc": "没门没派，就陪他熬一夜（散人路径）",
          "cond": {
            "noSect": true,
            "notFlag": "act2_gs_ledger"
          },
          "once": true,
          "effects": [
            {
              "type": "narrate",
              "raw": "你陪他在枫桥守了一夜。四更天有船过，帮上一点火都没点。他数完船，只说了一句：「这个记号，我见第三回了。」"
            },
            {
              "type": "narrate",
              "raw": "你顺着他的眼神看过去。船帮内侧刻着弯钩，钩尾挑得老高。走这记号的船，装的不止漕米。"
            },
            {
              "type": "flag",
              "args": [
                "act2_gs_ledger"
              ]
            }
          ]
        }
      ]
    },
