    "jn_apothecary": {
      "id": "jn_apothecary",
      "name": "陈济仁",
      "title": "回春堂坐堂",
      "gender": "male",
      "age": 61,
      "tag": "doctor",
      "room": "jn_pharmacy",
      "desc": "白发白须，坐在柜台后头给人号脉。三根手指搭在病人腕上，眼睛半闭着。",
      "level": 9,
      "hp": 320,
      "mp": 180,
      "atk": 12,
      "def": 8,
      "dodge": 6,
      "speed": 10,
      "hostile": false,
      "leavesCorpse": false,
      "shop": "shop_huichuntang",
      "favorInit": 2,
      "favorBase": 0.85,
      "talk": [
        "病来如山倒，去如抽丝。急不得。",
        "（他把你手腕翻过来，看了看指节）……练过功夫的人，脉不一样。",
        "这药柜里三百二十七个抽屉，哪个装什么，我闭着眼也摸得着。"
      ],
      "ask": {
        "医术": "医术没什么玄的：认得药，认得人，认得自己的手。",
        "回春堂": "开了三十一年。前面的掌柜姓周，传给我是因为我没儿子，他也没儿子。",
        "药材": "要好的药材往北边山里找，要便宜的往南边码头等。",
        "疗伤": "金创药敷外伤，内伤得煎药吃。你要是硬扛着，我这儿还有棺材的尺寸。"
      },
      "askDefault": "（他摇摇头）老朽只会看病。"
    },
    "jn_silkkeeper": {
      "id": "jn_silkkeeper",
      "name": "闻素娘",
      "title": "绸缎庄掌柜",
      "gender": "female",
      "age": 47,
      "tag": "vendor",
      "room": "jn_silk_shop",
      "desc": "四十来岁的妇人，两指间常年摸料子，磨出一层薄茧。她说话时手从不空着。",
      "level": 6,
      "hp": 220,
      "atk": 8,
      "def": 6,
      "dodge": 8,
      "speed": 12,
      "hostile": false,
      "leavesCorpse": false,
      "shop": "shop_silk",
      "favorInit": 1,
      "talk": [
        "（她把一卷料子往柜台上一摊）摸摸这手感。这是杭绸，那是蜀锦。",
        "料子这东西，一眼就看得出贵贱。人也一样。",
        "穿得体面，走到哪儿门房都不敢拦你。"
      ],
      "askDefault": "（她只顾理一匹缎子）要买就说，不买别摸。"
    },
    "jn_winewaiter": {
      "id": "jn_winewaiter",
      "name": "常阿福",
      "title": "醉仙楼伙计",
      "gender": "male",
      "age": 19,
      "tag": "waiter",
      "room": "jn_wine_house",
      "desc": "肩上搭一条白巾，在桌子之间穿来穿去，两脚几乎不沾地。",
      "level": 4,
      "hp": 160,
      "atk": 6,
      "def": 4,
      "dodge": 14,
      "speed": 18,
      "hostile": false,
      "leavesCorpse": false,
      "shop": "shop_wine",
      "favorInit": 1,
      "talk": [
        "客官打尖还是住店？楼上雅间还空着两间。",
        "本店的醉仙酿，一坛下去能让人忘了自己姓什么。",
        "（他把白巾甩上肩）后厨的师傅脾气大，菜催不得。"
      ],
      "askDefault": "（他一边擦桌子一边应）小的就是个跑堂的，不懂那些。"
    },
    "jn_bookman": {
      "id": "jn_bookman",
      "name": "林守拙",
      "title": "翰墨斋东家",
      "gender": "male",
      "age": 52,
      "tag": "scholar",
      "room": "jn_bookshop",
      "desc": "青衫上沾着几点墨，手里总捏着半卷没看完的书，看人时眼睛先从书上抬起来。",
      "level": 7,
      "hp": 200,
      "atk": 8,
      "def": 6,
      "dodge": 7,
      "speed": 11,
      "hostile": false,
      "leavesCorpse": false,
      "shop": "shop_book",
      "favorInit": 2,
      "talk": [
        "书是死的，人是活的。可人不读书，就连死的也比不上。",
        "这一册是孤本。价钱嘛……看你识不识货。",
        "买回去别垫桌脚。"
      ],
      "ask": {
        "学问": "学问二字，一是学，二是问。光看不想，等于没看。",
        "古书": "真古书纸是黄的，字是黑的，墨会往纸里走。假的墨浮在面上。",
        "武功": "书上写的招式都是死的，真打起来，谁跟你一章一章来。"
      },
      "askDefault": "（他随口应了一声，眼睛又回到书上）"
    },
    "jn_tutor": {
      "id": "jn_tutor",
      "name": "陆见山",
      "title": "白鹿书院主讲",
      "gender": "male",
      "age": 58,
      "tag": "scholar",
      "room": "jn_school",
      "desc": "面容清癯，讲书时目光落在案上那卷经上，不看堂下的人。",
      "level": 8,
      "hp": 240,
      "atk": 10,
      "def": 7,
      "dodge": 7,
      "speed": 12,
      "hostile": false,
      "leavesCorpse": false,
      "favorInit": 1,
      "talk": [
        "读书不为功名，为的是心里那杆秤。秤准了，人就不歪。",
        "你若要问学问，先在这堂里坐得住三日。",
        "（他停了停）习武的人也来听讲，少见。"
      ],
      "ask": {
        "学问": "先辨是非，再论利害。多数人反着来，所以一世糊涂。",
        "书院": "白鹿书院三百年了。出过状元，也出过反贼，都算我的学生。",
        "习武": "刀剑能护身，护不住心。心里没个准绳，本事越大越坏事。"
      },
      "askDefault": "（他抬眼看你一下，又低下头去）"
    },
    "jn_smithman": {
      "id": "jn_smithman",
      "name": "石大山",
      "title": "铁匠",
      "gender": "male",
      "age": 44,
      "tag": "smith",
      "room": "jn_smith_inner",
      "desc": "光着上身，胳膊上全是火燎出来的疤。锤子落下去的节奏几十年没变过。",
      "level": 12,
      "hp": 420,
      "atk": 26,
      "def": 16,
      "dodge": 8,
      "speed": 12,
      "hostile": false,
      "leavesCorpse": false,
      "shop": "shop_blacksmith",
      "favorInit": 1,
      "talk": [
        "（他没抬头，锤子继续落）有话说，等我这口打完。",
        "铁要烧透了才吃得进火。人心也一样，半生不熟的敲不出好家伙。",
        "我打了三十年铁，没打过一把给自己用的。"
      ],
      "ask": {
        "兵器": "剑要轻，刀要沉。挑兵器看胳膊，别看价钱。",
        "打铁": "打铁先学看火。火色对了，铁自己就会走。",
        "武功": "我只懂锤子。不过天下武学，说到根上都是个「熟」字。"
      },
      "askDefault": "（他抡起锤子，火星四溅）"
    },
    "jn_grocer": {
      "id": "jn_grocer",
      "name": "崔五",
      "title": "杂货铺掌柜",
      "gender": "male",
      "age": 38,
      "tag": "vendor",
      "room": "jn_misc_shop",
      "desc": "瘦高个，袖子里塞着算盘，说话时手不停地在袖口里拨珠子。",
      "level": 5,
      "hp": 180,
      "atk": 7,
      "def": 5,
      "dodge": 9,
      "speed": 13,
      "hostile": false,
      "leavesCorpse": false,
      "shop": "shop_grocery",
      "favorInit": 1,
      "talk": [
        "（他拨了两下算盘）样样都有，样样都不贵。",
        "客官要出门远行？水葫芦、皮囊、粗麻袋，一样都不能少。",
        "小本买卖，不赊账。"
      ],
      "askDefault": "（他指指货架）要什么自己看，都在架上。"
    },
    "jn_villagekeep": {
      "id": "jn_villagekeep",
      "name": "孙阿婆",
      "title": "村口小铺",
      "gender": "female",
      "age": 66,
      "tag": "vendor",
      "room": "cunzhen_inn",
      "desc": "坐在门槛边纳鞋底的老太太，铺子小得只摆得下三只篮子。",
      "level": 3,
      "hp": 140,
      "atk": 4,
      "def": 4,
      "dodge": 4,
      "speed": 8,
      "hostile": false,
      "leavesCorpse": false,
      "shop": "shop_village",
      "favorInit": 3,
      "talk": [
        "（她放下鞋底）外乡人？这村子小，往东是大路，往西是山。",
        "馒头是今早蒸的，还热着。",
        "赶路的人，多带两个。山里没得买。"
      ],
      "askDefault": "（她眯着眼看了你一会儿，又低头纳鞋底）"
    },
    "jn_fruitman": {
      "id": "jn_fruitman",
      "name": "柳甜儿",
      "title": "果子摊主",
      "gender": "female",
      "age": 24,
      "tag": "vendor",
      "room": "jn_fruit_stall",
      "desc": "竹筐里码着果子，她在摊前哼着小调，一边挑出不能卖的坏果。",
      "level": 4,
      "hp": 150,
      "atk": 6,
      "def": 4,
      "dodge": 11,
      "speed": 14,
      "hostile": false,
      "leavesCorpse": false,
      "shop": "shop_fruit",
      "favorInit": 2,
      "talk": [
        "刚下来的桃，尝一个不要钱。",
        "（她把一颗荔枝在手里颠了颠）这东西，运到城里就贵了。",
        "果子摘下来就一天比一天不甜，人也一样。"
      ],
      "askDefault": "（她笑着摆手）我只管卖果子。"
    },
    "jn_diviner": {
      "id": "jn_diviner",
      "name": "徐半仙",
      "title": "算命先生",
      "gender": "male",
      "age": 55,
      "tag": "commoner",
      "room": "jn_fortune",
      "desc": "一方旧布幌子上写着「半仙」，他坐在摊后，眼睛像是看着你，又像是看着你身后。",
      "level": 3,
      "hp": 130,
      "atk": 5,
      "def": 4,
      "dodge": 6,
      "speed": 9,
      "hostile": false,
      "leavesCorpse": false,
      "favorInit": 1,
      "talk": [
        "（他捻着胡子）客官面有风尘色，是刚赶了远路。",
        "卦不敢算尽，算尽了就没意思了。",
        "你信则有，不信……也还是有。"
      ],
      "ask": {
        "算命": "我算过一千个人的命，有一半准。准的那一半，都照着我的话去做了。",
        "面相": "眉看早年，眼看中年，颧看晚年。你眼下发青，近日少动气。",
        "江湖": "江湖上的事我不多嘴。看多了，知道得越少睡得越香。"
      },
      "askDefault": "（他闭上眼，摇了摇手里的六枚铜钱）"
    },
    "jn_porter": {
      "id": "jn_porter",
      "name": "王大壮",
      "title": "码头脚夫",
      "gender": "male",
      "age": 31,
      "tag": "boatman",
      "room": "jn_harbor",
      "desc": "膀大腰圆，一根扁担横在肩上，晒得跟码头的木头一样黑。",
      "level": 8,
      "hp": 300,
      "atk": 20,
      "def": 10,
      "dodge": 7,
      "speed": 11,
      "hostile": false,
      "leavesCorpse": false,
      "favorInit": 1,
      "talk": [
        "（他把扁担换个肩）要搬什么？按斤算钱。",
        "码头上一天三班船，早班往上游，晚班往下游。",
        "我这身子是干活练出来的，不是练武练出来的。"
      ],
      "ask": {
        "搬运": "一百斤的包，走三里地，二十文。嫌贵你自个儿扛。",
        "码头": "往南的船走水路最快，往北得翻山。",
        "水性": "这江水看着平，底下有暗流。会水的也淹死过。"
      },
      "askDefault": "（他闷头把一只木箱往肩上送）"
    },
    "jn_pawnclerk": {
      "id": "jn_pawnclerk",
      "name": "古伯",
      "title": "当铺朝奉",
      "gender": "male",
      "age": 59,
      "tag": "vendor",
      "room": "jn_pawnshop",
      "desc": "高柜台后头只露出半张脸和一双眼睛。手指又细又长，拿东西时像在称重。",
      "level": 6,
      "hp": 200,
      "atk": 8,
      "def": 8,
      "dodge": 6,
      "speed": 10,
      "hostile": false,
      "leavesCorpse": false,
      "shop": "shop_pawn",
      "favorInit": 1,
      "talk": [
        "（他隔着柜台看东西，不看你）当多少？",
        "死当不退。想清楚了再画押。",
        "到了我这柜上的东西，多半是主人实在没法子了。"
      ],
      "ask": {
        "当铺": "当一收三。不是我狠，是东西押在手里也要担风险。",
        "眼力": "看物件先看真不真，再看有没有人要。第二样比第一样难。"
      },
      "askDefault": "（他把一张当票推过来）"
    }
  },
